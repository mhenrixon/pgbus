# pgbus dogfood .dockerignore — trims the REPO-ROOT build context.
#
# The docs site (docs/) dogfoods the gem via `gem "pgbus", path: ".."`, so the
# Docker build context is the repo root: the gem at /app, the app at /app/docs
# (see docs/Dockerfile). This file keeps that context small — without it the
# daemon ships ~900 MB of spec artifacts, node_modules, coverage, and the codedb
# snapshot into the build and the COPY layers balloon.
#
# .git MUST ship: pgbus.gemspec packages its files via `git ls-files` with NO
# Dir[] fallback, and Bundler re-evaluates the gemspec both at `bundle install`
# (build stage) and at BOOT (final stage) — without .git the file list comes back
# empty and the path dep breaks. Do NOT add /.git/ here.

# Git helper files (safe to drop — only the .git dir itself is needed).
/.gitignore
/.gitattributes

# Editor + AI-assistant configs (gem-level and app-level).
/.claude/
/.cursor/
/.vscode/
/.idea/
/.ruby-lsp/
/.solargraph.yml
/.worktrees/
/.flow/
/.herb/
/.herb.yml

# Gem-level dev/test artifacts — not part of the docs app image. The gemspec's
# file list is app/ + config/ + exe/ + lib/ (+ a few root md files); it never
# ships spec/, benchmarks/, or coverage/, so excluding them can't starve
# `bundle install`.
/spec/
/.rspec
/.rspec_status
/.rspec_integration_status
/coverage/
/codedb.snapshot
/benchmarks/
/sig/
/tmp/
/pkg/
/doc/
/.yardoc

# Gem-level JS toolchain (repo-root lint/tooling deps — the docs app has its own).
/node_modules/
/package-lock.json

# CI meta.
/.github/

# Bundler config (the Dockerfile's BUNDLE_* env drives the install).
/.bundle
/docs/.bundle

# Environment files and credentials — never bake secrets into an image.
/.env*
/docs/.env*
/docs/config/master.key
/docs/config/credentials/*.key

# --- The docs app (docs/) --------------------------------------------------
# JS deps + generated assets: `bun install` + `assets:precompile` rebuild these
# inside the build stage.
/docs/node_modules/
/docs/app/assets/builds/*
!/docs/app/assets/builds/.keep
# Generated by bin/build-css — Tailwind resolves the gem @source globs at build.
/docs/app/assets/stylesheets/tailwind.sources.css
/docs/public/assets

# Logs and tempfiles (keep the dirs, drop the contents).
/docs/log/*
!/docs/log/.keep
/docs/tmp/*
!/docs/tmp/.keep
/docs/tmp/pids/*
!/docs/tmp/pids/.keep

# The docs app's own tests + deploy meta.
/docs/spec/
/docs/.rspec
/docs/coverage/
/docs/.kamal/
